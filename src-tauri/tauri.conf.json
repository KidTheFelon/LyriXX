{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LyriXX",
  "version": "0.4.0",
  "identifier": "com.lyrixx.note",
  "build": {
    "beforeDevCommand": "npm run dev -- --host",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "title": "",
        "url": "/splash.html",
        "width": 400,
        "height": 280,
        "decorations": false,
        "center": true,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true
      },
      {
        "label": "main",
        "title": "LyriXX",
        "width": 1280,
        "height": 720,
        "minWidth": 800,
        "minHeight": 600,
        "decorations": false,
        "transparent": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "assets/app/icon-32.png",
      "assets/app/icon-128.png",
      "assets/app/icon-256.png",
      "assets/icon-32.ico",
      "assets/app.ico"
    ],
    "windows": {
      "nsis": null
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": [
          "libgtk-3-0",
          "libwebkit2gtk-4.1-0",
          "libappindicator3-1"
        ]
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
